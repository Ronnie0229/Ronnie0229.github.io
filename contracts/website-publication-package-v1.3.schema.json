{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ronniecross.local/contracts/website-publication-package-v1.3.schema.json",
  "title": "website-publication-package/v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interface",
    "version",
    "content_type",
    "prepublish",
    "official_chinese",
    "english_source",
    "fidelity_status",
    "translation_status",
    "metadata",
    "notification_policy",
    "archive_status",
    "presentation"
  ],
  "properties": {
    "interface": {
      "const": "website-publication-package"
    },
    "version": {
      "const": "1.3"
    },
    "content_type": {
      "enum": [
        "share",
        "sermon"
      ]
    },
    "prepublish": {
      "$ref": "#/$defs/fileRef"
    },
    "official_chinese": {
      "$ref": "#/$defs/fileRef"
    },
    "english_source": {
      "$ref": "#/$defs/fileRef"
    },
    "fidelity_status": {
      "enum": [
        "independently_verified",
        "pass_by_max_audit_policy",
        "authorized_exception",
        "not_required"
      ]
    },
    "translation_status": {
      "enum": [
        "translated",
        "not_translated"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "publish_date",
        "batch_id",
        "content_type"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "publish_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "enum": [
            "share",
            "sermon"
          ]
        },
        "category": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        }
      }
    },
    "notification_policy": {
      "enum": [
        "normal_first_publish",
        "suppress",
        "manual_authorization_required"
      ]
    },
    "archive_status": {
      "enum": [
        "not_applicable",
        "pending",
        "archived",
        "pending_mount",
        "verification_failed"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "artifact",
        "manifest_sha256",
        "content_type",
        "profile",
        "presentation_status",
        "text_identity_status",
        "candidate_sha256",
        "artifact_sha256",
        "record_identity"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_type": {
          "enum": [
            "share",
            "sermon"
          ]
        },
        "profile": {
          "enum": [
            "share_article",
            "sermon"
          ]
        },
        "presentation_status": {
          "const": "mechanically_verified"
        },
        "text_identity_status": {
          "const": "exact_record_order_preserved"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_count",
            "record_order_sha256",
            "pair_set_sha256"
          ],
          "properties": {
            "record_count": {
              "type": "integer",
              "minimum": 1
            },
            "record_order_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "pair_set_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "content_type": {
            "const": "share"
          }
        },
        "required": [
          "content_type"
        ]
      },
      "then": {
        "properties": {
          "archive_status": {
            "const": "not_applicable"
          },
          "presentation": {
            "properties": {
              "content_type": {
                "const": "share"
              },
              "profile": {
                "const": "share_article"
              }
            }
          },
          "metadata": {
            "properties": {
              "content_type": {"const": "share"},
              "category": {"const": "灵命成长"}
            },
            "required": ["category", "author"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "content_type": {
            "const": "sermon"
          }
        },
        "required": [
          "content_type"
        ]
      },
      "then": {
        "properties": {
          "archive_status": {
            "enum": [
              "pending",
              "archived",
              "pending_mount",
              "verification_failed"
            ]
          },
          "presentation": {
            "properties": {
              "content_type": {
                "const": "sermon"
              },
              "profile": {
                "const": "sermon"
              }
            }
          },
          "metadata": {
            "properties": {
              "content_type": {"const": "sermon"},
              "category": {"const": "教会讲道"}
            },
            "required": ["category", "speaker"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "translation_status": {
            "const": "translated"
          }
        },
        "required": [
          "translation_status"
        ]
      },
      "then": {
        "properties": {
          "fidelity_status": {
            "enum": [
              "independently_verified",
              "pass_by_max_audit_policy",
              "authorized_exception"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "translation_status": {
            "const": "not_translated"
          }
        },
        "required": [
          "translation_status"
        ]
      },
      "then": {
        "properties": {
          "fidelity_status": {
            "const": "not_required"
          }
        }
      }
    }
  ]
}
