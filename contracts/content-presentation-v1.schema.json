{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ronniecross.local/contracts/content-presentation-v1.schema.json",
  "title": "content-presentation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interface",
    "version",
    "content_type",
    "profile",
    "candidate",
    "artifact",
    "record_identity",
    "presentation_status",
    "text_identity_status",
    "allowed_transformations",
    "validator"
  ],
  "properties": {
    "interface": {
      "const": "content-presentation"
    },
    "version": {
      "const": "1.0"
    },
    "content_type": {
      "enum": [
        "share",
        "sermon"
      ]
    },
    "profile": {
      "enum": [
        "share_article",
        "sermon"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "record_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "record_ids",
        "record_order_sha256",
        "pair_set_sha256"
      ],
      "properties": {
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "record_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "record_order_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pair_set_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "presentation_status": {
      "const": "mechanically_verified"
    },
    "text_identity_status": {
      "const": "exact_record_order_preserved"
    },
    "allowed_transformations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "blank_line_boundaries",
          "h2_h3_headings",
          "standard_markdown_lists",
          "blockquote",
          "whole_record_emphasis"
        ]
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "executed_at",
        "report_path",
        "report_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executed_at": {
          "type": "string",
          "format": "date-time"
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "content_type": {
            "const": "share"
          }
        },
        "required": [
          "content_type"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "const": "share_article"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "content_type": {
            "const": "sermon"
          }
        },
        "required": [
          "content_type"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "const": "sermon"
          }
        }
      }
    }
  ]
}
